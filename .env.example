# ==============================================================================
# FinXCore Platform Environment Configuration (Example Template)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
APP_NAME=FinXCore
API_V1_STR=/api/v1

# Security & Cryptography
SECRET_KEY=finxcore-super-secure-production-ready-jwt-and-signing-key-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY_BASE64=c3VwZXJzZWNyZXRrZXkxMjM0NTY3ODkwMTIzNDU2

# Database Connection (PostgreSQL for Prod / SQLite for Dev)
DATABASE_URL=sqlite:///./finxcore_banking.db
# DATABASE_URL=postgresql://finx_admin:finx_password@localhost:5432/finx_core_db

# Redis Caching & Locks
REDIS_URL=redis://localhost:6379/0

# Event Bus & Streaming
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
EVENT_BUS_BACKEND=memory

# Payment & Banking Rails Simulator
UPI_VPA_SUFFIX=@finx
SETTLEMENT_CYCLE=T_PLUS_0
DEFAULT_CURRENCY=INR

# Feature Flags
ENABLE_MFA=true
ENABLE_FRAUD_BLOCKING=true
ENABLE_AI_RECOMMENDATIONS=true
ENABLE_MULTI_RAIL_RECONCILIATION=true
